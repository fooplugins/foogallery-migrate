{
    "name": "fooplugins/foogallery-migrate",
    "description": "FooGallery Migrate",
    "type": "library",
    "autoload"    : {
        "psr-4" : {
            "FooPlugins\\FooGalleryMigrate\\" : "includes"
        },
	  	"classmap": [ "includes" ]
    },
    "extra": {
        "installer-paths": {
            "vendor/{$name}/": ["type:wordpress-plugin"]
        }
    },
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Brad Vincent"
        }
    ],
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "require": {
        "composer/installers": "^2.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "doctrine/instantiator": "^1.5"
    }
}
