FROM php:5.6-cli@sha256:6ce95208609dc66df163ab936c970b3b34cd901b85c747102c5999f08ade9143

# The 5.4 Docker Hub image has an obsolete v1 manifest. Build the final
# upstream 5.4 patch release in the contemporary official 5.6 toolchain.
# Stretch OpenSSL excludes SSLv3 methods; those obsolete selections refuse
# instead of producing unresolved symbols, while ordinary TLS stays enabled.
RUN printf 'deb http://archive.debian.org/debian stretch main\n' > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --allow-unauthenticated --no-install-recommends \
        autotools-dev libxml2-dev libssl1.0-dev zlib1g-dev libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*
COPY php-5.4.45.tar.gz /tmp/php-5.4.45.tar.gz
RUN echo '25bc4723955f4e352935258002af14a14a9810b491a19400d76fcdfa9d04b28f  /tmp/php-5.4.45.tar.gz' | sha256sum -c - \
    && mkdir /tmp/php-5.4.45 \
    && tar -xzf /tmp/php-5.4.45.tar.gz -C /tmp/php-5.4.45 --strip-components=1 \
    && cd /tmp/php-5.4.45 \
    && cp /usr/share/misc/config.guess /usr/share/misc/config.sub . \
    && sed -i 's/method = SSLv3_client_method();/return -1;/' ext/openssl/xp_ssl.c \
    && sed -i 's/method = SSLv3_server_method();/return -1;/' ext/openssl/xp_ssl.c \
    && ./configure --prefix=/opt/php54 --disable-all --enable-cli --disable-cgi \
        --enable-ctype --enable-filter --enable-hash --enable-json \
        --enable-libxml --enable-mbstring --enable-pdo --enable-phar \
        --enable-session --enable-simplexml --enable-tokenizer \
        --enable-xml --enable-xmlreader --enable-xmlwriter \
        --with-curl --with-mysqli=mysqlnd --with-pdo-mysql=mysqlnd \
        --with-openssl --with-zlib \
    && make -j2 \
    && make install \
    && /opt/php54/bin/php -r 'if (PHP_VERSION !== "5.4.45" || !extension_loaded("mysqli")) exit(1);' \
    && rm -rf /tmp/php-5.4.45 /tmp/php-5.4.45.tar.gz

ENV PATH=/opt/php54/bin:$PATH
WORKDIR /site
